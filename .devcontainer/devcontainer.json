{
  "name": "ROS 2 Humble (Pop!_OS Dev Container)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "ros2_humble_dev",
  "workspaceFolder": "/root/ros2_ws",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
